# Standalone Postgres database for this app (NOT the WAF Manager DB).
# Create it once:  createdb adsp_audit   (or CREATE DATABASE adsp_audit;)
DATABASE_URL=postgresql+asyncpg://waf:wafmanager_dev@localhost:5432/adsp_audit

# JWT — required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

APP_NAME=Audit for ADSP
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin1234!
FIRST_ADMIN_EMAIL=admin@company.com
