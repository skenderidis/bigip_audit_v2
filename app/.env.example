# Copy this file to .env and fill in the secrets.  `docker compose` reads .env
# automatically. Never commit the real .env (it is git-ignored).

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=adsp_audit
POSTGRES_USER=waf
# REQUIRED. Choose a strong password. Any characters are fine — the backend
# URL-encodes it, so @ : / # & etc. are safe.
POSTGRES_PASSWORD=change-this-db-password

# ── Backend ────────────────────────────────────────────────────────────────
# REQUIRED. JWT signing + the key that encrypts the stored iHealth secret.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing it later invalidates all sessions and the stored iHealth
# credential (you would re-enter it under Settings).
SECRET_KEY=change-this-to-a-long-random-string

APP_NAME=Audit for BIGIP
ACCESS_TOKEN_EXPIRE_MINUTES=480

# "*" allows any origin without credentials. To lock down, use a JSON list,
# e.g. CORS_ORIGINS=["https://audit.example.com"]
CORS_ORIGINS=["*"]

# First-run admin account (created once, on an empty database).
FIRST_ADMIN_USERNAME=admin
# REQUIRED. Change this before first start; you can change it later in the app.
FIRST_ADMIN_PASSWORD=change-this-admin-password
FIRST_ADMIN_EMAIL=admin@company.com

# ── Web ────────────────────────────────────────────────────────────────────
# Host port the UI is published on (container is always :80 internally).
WEB_PORT=5175
