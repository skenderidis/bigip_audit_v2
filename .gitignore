# Secrets / local config — never commit (matches at any depth, e.g. app/.env)
.env
**/.env

# Python
**/__pycache__/
*.pyc
**/.venv/
**/data_seed/

# Node / build output
**/node_modules/
**/dist/

# Logs, OS cruft
*.log
.DS_Store
Thumbs.db

# Per-deployment runtime settings (shipped defaults are tracked; edits are not)
**/app/data/report_settings.json
